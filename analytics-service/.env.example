# Analytics Service (:8004) — copy to .env and adjust. See HLD section 4.5.

SERVICE_NAME=analytics-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required
DB_URL=postgresql+asyncpg://echoscope:echoscope@postgres:5432/echoscope

# Optional
KAFKA_BROKERS=kafka:9092
REDIS_URL=redis://redis:6379/0
SPIKE_THRESHOLD=2.0
TREND_WINDOW_HOURS=24
CACHE_TTL=300
