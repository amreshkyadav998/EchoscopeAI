# ─────────────────────────────────────────────────────────────────────────────
# Root infrastructure environment (docker-compose.yml reads these).
#
# Copy this file to `.env` and adjust values for your local machine:
#     cp .env.example .env
#
# `.env` is gitignored — never commit real credentials.
# Per-service application env files are added in their respective phases.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──
# POSTGRES_PORT is the HOST-published port. If a native PostgreSQL already runs on
# 5432, set this to 5433 (or any free port) to avoid the conflict. The internal
# docker-network port is always 5432 (services connect to postgres:5432).
POSTGRES_USER=echoscope
POSTGRES_PASSWORD=echoscope
POSTGRES_DB=echoscope
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── Kafka ──
# Host-side port for connecting from your machine (internal services use kafka:9092).
KAFKA_HOST_PORT=29092
