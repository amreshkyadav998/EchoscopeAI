# Notification Service (:8005) — copy to .env and adjust. See HLD section 4.6.

SERVICE_NAME=notification-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required
DB_URL=postgresql+asyncpg://echoscope:echoscope@postgres:5432/echoscope

# Optional
KAFKA_BROKERS=kafka:9092
REDIS_URL=redis://redis:6379/0
WS_HEARTBEAT_INTERVAL=30
EMAIL_FROM_ADDRESS=alerts@echoscope.local

# Email provider key (leave blank until Phase 10)
SENDGRID_API_KEY=
