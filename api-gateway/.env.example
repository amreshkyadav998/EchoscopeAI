# API Gateway (:8000) — copy to .env and adjust. See HLD section 4.1.

# Shared (from echoscope_common.BaseAppSettings)
SERVICE_NAME=api-gateway
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required
JWT_SECRET=change-me-in-production

# Optional
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_MAX=100
# SERVICE_URLS is a JSON object; omit to use the built-in docker-network defaults.
# SERVICE_URLS={"auth":"http://auth-service:8001","mention":"http://mention-service:8002"}
