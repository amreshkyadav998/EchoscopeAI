# NLP / AI Service (:8003) — copy to .env and adjust. See HLD section 4.4.

SERVICE_NAME=nlp-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required
DB_URL=postgresql+asyncpg://echoscope:echoscope@postgres:5432/echoscope

# Optional
KAFKA_BROKERS=kafka:9092
HF_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
GPU_ENABLED=false
MAX_TEXT_LENGTH=512
SUMMARY_CACHE_TTL=3600

# AI provider key (leave blank until Phase 7)
OPENAI_API_KEY=
