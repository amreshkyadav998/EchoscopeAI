# Report Service (:8006) — copy to .env and adjust. See HLD section 4.7.

SERVICE_NAME=report-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required
DB_URL=postgresql+asyncpg://echoscope:echoscope@postgres:5432/echoscope

# Optional
REDIS_URL=redis://redis:6379/0
KAFKA_BROKERS=kafka:9092
CELERY_BROKER_URL=redis://redis:6379/1
AWS_REGION=us-east-1

# S3 credentials (leave blank until Phase 11)
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
