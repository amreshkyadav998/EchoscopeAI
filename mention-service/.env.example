# Mention Collection Service (:8002) — copy to .env and adjust. See HLD section 4.3.

SERVICE_NAME=mention-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required
DB_URL=postgresql+asyncpg://echoscope:echoscope@postgres:5432/echoscope

# Optional
REDIS_URL=redis://redis:6379/0
KAFKA_BROKERS=kafka:9092
SCRAPE_INTERVAL_MINUTES=30
CELERY_BROKER_URL=redis://redis:6379/1

# Scraper credentials (leave blank until Phase 6)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEWSAPI_KEY=
