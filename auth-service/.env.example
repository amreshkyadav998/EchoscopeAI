# Auth Service (:8001) — copy to .env and adjust. See HLD section 4.2.

SERVICE_NAME=auth-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required
# In Docker, services reach Postgres at host "postgres" on 5432 (value below).
# Running on the HOST instead? Use the published port and an explicit IPv4 host:
#   DB_URL=postgresql+asyncpg://echoscope:echoscope@127.0.0.1:5433/echoscope
# (5433 because a native Postgres may hold 5432; 127.0.0.1 because the container
#  publishes on IPv4 only and "localhost" can resolve to IPv6 on Windows.)
DB_URL=postgresql+asyncpg://echoscope:echoscope@postgres:5432/echoscope
JWT_SECRET=change-me-in-production

# Optional
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=7
REDIS_URL=redis://redis:6379/0
SMTP_HOST=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
